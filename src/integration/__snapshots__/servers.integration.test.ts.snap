          "type": "string",
        },
        "before": {
          "description": "ISO 8601 date. Only return emails received strictly before it. A bare date means local midnight. Example: '2025-03-01'.",
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Maximum number of results to return (1–100). Default: 25.",
