            "type": "string",
          },
          "type": "array",
        },
        "from": {
          "description": "Optional sender email address. Must match an enabled account.",
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "subject": {
          "description": "Email subject line.",
          "minLength": 1,
          "type": "string",
        },
        "to": {
          "description": "Recipient email addresses. At least one required.",
