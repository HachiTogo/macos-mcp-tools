exports[`tools/list contract contacts tools match the snapshot 1`] = `
[
  {
    "annotations": undefined,
    "description": "Manage Apple Contacts people. Actions: read (list), search, get (full detail), create, update, delete.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "action": {
          "description": "Operation to perform",
          "enum": [
            "read",
            "search",
            "get",
            "create",
            "update",
            "delete",
          ],
          "type": "string",
        },
        "confirm": {
          "description": "Must be true to confirm delete",
          "type": "boolean",
        },
        "emails": {
          "description": "Email addresses (create/update — adds, does not remove)",
          "items": {
            "properties": {
              "label": {
                "type": "string",
              },
              "value": {
                "type": "string",
              },
            },
            "required": [
              "label",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "first_name": {
          "description": "First name (create/update)",
          "type": "string",
        },
        "id": {
          "description": "Contact ID (get/update/delete)",
          "type": "string",
        },
        "job_title": {
          "description": "Job title (create/update)",
          "type": "string",
        },
        "last_name": {
          "description": "Last name (create/update)",
          "type": "string",
        },
        "limit": {
          "default": 100,
          "description": "Max contacts to return (read/search)",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "note": {
          "description": "Note text (create/update)",
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Pagination offset (read/search)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "organization": {
          "description": "Organization (create/update)",
          "type": "string",
        },
        "phones": {
          "description": "Phone numbers (create/update — adds, does not remove)",
          "items": {
            "properties": {
              "label": {
                "type": "string",
              },
              "value": {
                "type": "string",
              },
            },
            "required": [
              "label",
              "value",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "query": {
          "description": "Search query (search action)",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "contacts_people",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Manage Apple Contacts groups. Actions: read (list all), get (members of a group), create, delete, add_member, remove_member.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "action": {
          "description": "Operation to perform",
          "enum": [
            "read",
            "get",
            "create",
            "delete",
            "add_member",
            "remove_member",
          ],
          "type": "string",
        },
        "confirm": {
          "description": "Must be true to confirm delete",
          "type": "boolean",
        },
        "name": {
          "description": "Group name (get/create/delete/add_member/remove_member)",
          "type": "string",
        },
        "person_id": {
          "description": "Contact ID for add_member/remove_member",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "contacts_groups",
    "outputSchema": undefined,
  },
]
`;

