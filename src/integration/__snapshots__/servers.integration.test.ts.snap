            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "type": "string",
        },
      },
      "required": [
        "source",
        "chatId",
        "participants",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Send an iMessage to a phone number, email address, or group chat. For group chats, use the chat identifier (e.g. 'chat123456789012345678') from list_chats.",
    "inputSchema": {
