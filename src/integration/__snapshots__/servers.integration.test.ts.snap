    "name": "send_email",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Reply to an existing Apple Mail message by handle. Set replyAll=true to reply to all recipients.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
