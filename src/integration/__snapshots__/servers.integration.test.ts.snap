[
  {
    "annotations": undefined,
    "description": "List the Apple Mail accounts and mailboxes this server can see, with unread counts. Call this before filtering: 'provider' and 'mailbox' on unread_emails and search_emails only accept values that exist here, and a value that matches nothing returns an empty result rather than an error.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object",
    },
    "name": "list_mail_accounts",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Read unread Apple Mail messages without fetching bodies. Counts every unread message, in every category. For Gmail, that means mail in the inbox or under any label; archived mail with no label is left out, and each message is reported under its label rather than as INBOX.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "limit": {
          "default": 25,
          "description": "Maximum number of messages to return (1–100). Default: 25.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "mailbox": {
          "description": "Substring filter on mailbox name or URL (e.g. 'INBOX', 'work').",
          "type": "string",
        },
        "offset": {
          "default": 0,
          "description": "Skip this many matching messages before returning; use with limit to page.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "provider": {
          "description": "Filter to a specific email provider.",
          "enum": [
            "gmail",
            "icloud",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "unread_emails",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Mark Apple Mail messages as read. Each item in 'emails' must be a full email object with 'id', 'subject', and 'handle' fields — pass the objects exactly as returned by unread_emails, not bare handle objects.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "emails": {
          "description": "Array of email objects to mark as read.",
          "items": {
            "properties": {
              "handle": {
                "properties": {
                  "accountId": {
                    "type": "string",
                  },
                  "mailId": {
                    "type": "string",
                  },
                  "mailboxUrl": {
                    "type": "string",
                  },
                },
                "required": [
                  "accountId",
                  "mailboxUrl",
                  "mailId",
                ],
                "type": "object",
              },
              "id": {
                "type": "string",
              },
              "subject": {
                "type": "string",
              },
            },
            "required": [
              "id",
              "handle",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "emails",
      ],
      "type": "object",
    },
    "name": "mark_emails_read",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Fetch the full body text of a single Apple Mail message by its handle.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
