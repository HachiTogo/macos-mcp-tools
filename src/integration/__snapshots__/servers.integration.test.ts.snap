          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "search_emails",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Compose and send a new email via Apple Mail. Requires at least one 'to' recipient. Plain text body only.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
