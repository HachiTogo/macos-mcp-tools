exports[`tools/list contract messages tools match the snapshot 1`] = `
[
  {
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "List recent iMessage/SMS conversations with last message preview and participant count.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "limit": {
          "default": 50,
          "description": "Maximum conversations to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "list_chats",
    "outputSchema": undefined,
  },
  {
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Get message history for a specific conversation. Use chat_identifier values from list_chats (phone number, email, or group chat ID like 'chat123456').",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Chat identifier: phone number (e.g. '+15555550123'), email, or group ID (e.g. 'chat123456789012345678').",
          "type": "string",
        },
        "from_date": {
          "description": "ISO 8601 date. Only return messages on or after it. A bare date means local midnight; add a time or zone to be explicit. Example: '2026-01-15' or '2026-01-15T09:00:00Z'.",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "Maximum messages to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "to_date": {
          "description": "ISO 8601 date. Only return messages before it. A bare date means local midnight. Example: '2026-02-01'.",
          "type": "string",
        },
      },
      "required": [
        "chat_id",
      ],
      "type": "object",
    },
    "name": "get_messages",
    "outputSchema": undefined,
  },
  {
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Search messages by text content across all conversations, or within a specific conversation. Matches case-insensitively, including rich-text message bodies.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Limit search to a specific chat identifier.",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "Maximum results to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Text to search for in message content.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_messages",
    "outputSchema": undefined,
  },
  {
    "annotations": {
      "readOnlyHint": true,
    },
    "description": "Get participants of a conversation. Useful for identifying group chat members.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Chat identifier from list_chats.",
          "type": "string",
        },
      },
      "required": [
        "chat_id",
      ],
      "type": "object",
    },
    "name": "get_participants",
    "outputSchema": undefined,
  },
  {
    "annotations": undefined,
    "description": "Send an iMessage to a phone number, email address, or group chat. For group chats, use the chat identifier (e.g. 'chat123456789012345678') from list_chats.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "text": {
          "description": "Message text to send.",
          "minLength": 1,
          "type": "string",
        },
        "to": {
          "description": "Recipient: phone number (e.g. '+15555550123'), email, or group chat identifier (e.g. 'chat123456789012345678').",
          "type": "string",
        },
      },
      "required": [
        "to",
        "text",
      ],
      "type": "object",
    },
    "name": "send_message",
    "outputSchema": undefined,
  },
]
`;

exports[`tools/list contract events tools match the snapshot 1`] = `
[
  {
    "annotations": undefined,
    "description": "Manages calendar events (time blocks). Supports reading, creating, updating, and deleting calendar events.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "action": {
          "description": "The operation to perform",
          "enum": [
            "read",
            "create",
            "update",
            "delete",
          ],
          "type": "string",
        },
        "alarms": {
          "description": "Alarms for the event",
          "items": {
            "properties": {
              "absoluteDate": {
                "description": "Absolute trigger date/time",
                "type": "string",
              },
              "alarmType": {
                "description": "READ-ONLY: Alarm presentation type",
                "enum": [
                  "display",
                  "audio",
                  "procedure",
                  "email",
                ],
                "type": "string",
              },
              "locationTrigger": {
                "properties": {
                  "latitude": {
                    "type": "number",
                  },
                  "longitude": {
                    "type": "number",
                  },
                  "proximity": {
                    "enum": [
                      "enter",
                      "leave",
                    ],
                    "type": "string",
                  },
                  "radius": {
                    "type": "number",
                  },
                  "title": {
                    "type": "string",
                  },
                },
                "required": [
                  "title",
                  "latitude",
                  "longitude",
                  "proximity",
                ],
                "type": "object",
              },
              "relativeOffset": {
                "description": "Seconds offset (negative = before start)",
                "type": "number",
              },
            },
            "type": "object",
          },
          "type": "array",
        },
        "availability": {
          "description": "Event availability",
          "enum": [
            "not-supported",
            "busy",
            "free",
            "tentative",
            "unavailable",
          ],
          "type": "string",
        },
        "clearAlarms": {
          "description": "Set to true to remove all alarms from the event",
          "type": "boolean",
        },
        "clearRecurrence": {
          "description": "Set to true to remove recurrence rules from the event",
          "type": "boolean",
        },
        "endDate": {
          "description": "End date and time. RECOMMENDED format: 'YYYY-MM-DD HH:mm:ss' (local time). Also supports ISO 8601",
          "type": "string",
        },
        "filterAccount": {
          "description": "Filter events by account name",
          "type": "string",
        },
        "filterCalendar": {
          "description": "Filter events by a specific calendar name",
          "type": "string",
        },
        "id": {
          "description": "The unique identifier of the event (REQUIRED for update, delete; optional for read to get that one event, at any date). A recurring event's id names the series; read returns its first occurrence.",
          "type": "string",
        },
        "isAllDay": {
          "description": "Whether the event is an all-day event",
          "type": "boolean",
        },
        "location": {
          "description": "Location text for the event",
          "type": "string",
        },
        "note": {
          "description": "Additional notes for the event",
          "type": "string",
        },
        "recurrenceRules": {
          "description": "Recurrence rules for repeating events",
