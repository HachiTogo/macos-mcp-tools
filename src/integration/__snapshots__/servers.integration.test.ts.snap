  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List calendar events in a date range (the next 14 days by default), optionally filtered by calendar, account, text or availability.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "account": {
          "description": "Only events in this account",
          "type": "string",
        },
        "availability": {
          "description": "Event availability",
          "enum": [
            "not-supported",
            "busy",
            "free",
            "tentative",
            "unavailable",
          ],
          "type": "string",
        },
        "calendar": {
          "description": "Only events in this calendar (title or id from list_calendars)",
          "type": "string",
        },
        "end_date": {
          "description": "Range end: 'YYYY-MM-DD HH:mm:ss' in local time (recommended), or ISO 8601",
          "type": "string",
        },
        "limit": {
          "description": "Return at most this many events (all by default)",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
