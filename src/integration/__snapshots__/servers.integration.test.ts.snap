[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List recent iMessage/SMS conversations with last message preview and participant count.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "limit": {
          "default": 50,
          "description": "Maximum conversations to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Skip this many matching conversations before returning; use with limit to page.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "list_chats",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "chats": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "chatId": {
                "type": "string",
              },
            },
            "required": [
              "chatId",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "type": "string",
        },
      },
      "required": [
        "source",
        "chats",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Get message history for a specific conversation. Use the chat_id list_chats shows (phone number, email, or group chat ID like 'chat123456').",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Chat identifier: phone number (e.g. '+15555550123'), email, or group ID (e.g. 'chat123456789012345678').",
          "type": "string",
        },
        "from_date": {
          "description": "ISO 8601 date. Only return messages on or after it. A bare date means local midnight; add a time or zone to be explicit. Example: '2026-01-15' or '2026-01-15T09:00:00Z'.",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "Maximum messages to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Skip this many of the newest matching messages; use with limit to page back in time. Each page is in chronological order.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "to_date": {
          "description": "ISO 8601 date. Only return messages before it. A bare date means local midnight. Example: '2026-02-01'.",
          "type": "string",
        },
      },
      "required": [
        "chat_id",
      ],
      "type": "object",
    },
    "name": "get_messages",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "chatId": {
          "type": "string",
        },
        "messages": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "id": {
                "type": "number",
              },
            },
            "required": [
              "id",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "type": "string",
        },
      },
      "required": [
        "source",
        "chatId",
        "messages",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Search messages by text content across all conversations, or within a specific conversation. Matches case-insensitively, including rich-text message bodies.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Limit search to a specific chat identifier.",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "Maximum results to return (1–200). Default: 50.",
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "offset": {
          "default": 0,
          "description": "Skip this many matching messages before returning; use with limit to page.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "query": {
          "description": "Text to search for in message content.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_messages",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "query": {
          "type": "string",
        },
        "results": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "chatId": {
                "type": "string",
              },
              "id": {
                "type": "number",
              },
            },
            "required": [
              "id",
              "chatId",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "type": "string",
        },
      },
      "required": [
        "source",
        "query",
        "results",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Get participants of a conversation. Useful for identifying group chat members.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "chat_id": {
          "description": "Chat identifier from list_chats.",
          "type": "string",
        },
      },
      "required": [
        "chat_id",
      ],
      "type": "object",
    },
    "name": "get_participants",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
