{
  "name": "@hachitogo/macos-mcp-tools",
  "version": "0.4.0",
  "description": "MCP servers for macOS: Apple Mail, Contacts, Notes, Memory, Messages, Calendar Events, and Reminders",
  "type": "module",
  "bin": {
    "macos-mcp-tools": "bin/macos-tools.js"
  },
  "files": [
    "bin/macos-tools.js",
    "src/cli.ts",
    "src/lib/jxa.ts",
    "src/lib/version.ts",
    "src/lib/mcp-result.ts",
    "src/servers/mail.ts",
    "src/servers/contacts.ts",
    "src/servers/notes.ts",
    "src/servers/memory.ts",
    "src/servers/messages.ts",
    "src/servers/events.ts",
    "src/servers/reminders.ts",
    "src/lib/eventkit/index.ts",
    "src/lib/eventkit/types.ts",
    "src/lib/eventkit/constants.ts",
    "src/lib/eventkit/helpers.ts",
    "src/lib/eventkit/schemas.ts",
    "src/lib/eventkit/cli-executor.ts",
    "src/lib/eventkit/date-utils.ts",
    "src/lib/eventkit/tags.ts",
    "src/lib/eventkit/subtasks.ts",
    "src/lib/eventkit/calendar-repository.ts",
    "src/lib/eventkit/reminder-repository.ts",
    "swift/EventKitCLI.swift",
    "swift/EventKitCLI.entitlements",
    "swift/Info.plist",
    "swift/build.mjs",
    "bin/EventKitCLI"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test src/integration",
    "test:integration:apps": "RUN_INTEGRATION_TESTS=1 RUN_APP_INTEGRATION_TESTS=1 bun test src/integration",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx --bun biome check .",
    "format": "bunx --bun biome check --write .",
    "build:swift": "bun swift/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": ["darwin"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HachiTogo/macos-mcp-tools.git"
  },
  "homepage": "https://github.com/HachiTogo/macos-mcp-tools#readme",
  "bugs": {
    "url": "https://github.com/HachiTogo/macos-mcp-tools/issues"
  },
  "keywords": ["mcp", "macos", "apple", "mail", "contacts", "notes", "messages", "imessage", "calendar", "events", "reminders", "eventkit"]
}
